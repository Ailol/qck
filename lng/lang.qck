# qck terminal law

& != terminal
' != execution
scatter'shot != security boundary

;     = close the chain
;*    = tiny wink
;**   = AI attent'
;***  = pirate/testing flourish' — give the statement its givens
;**** = compiler/errors; reserved for áshè

# áshè: programmer-side companion/parser voice — "á, yes it's different" ;*

statement ::= chain ';' flourish?
flourish  ::= '*'*

# single tooling rule
# flourish changes tooling context, never execution.
tooling(statement;**)  ::= ai'attent(statement)
tooling(statement;***) ::= givens(statement)

# '*' after ';' is preserved source flourish; no execution semantics.
# no further semantics until scatter'shot comes out.
